# Local / docker-compose only. In Kubernetes these keys come from Vault
# (private/data/prod-dataplatform/dataplatform-cost-dashboard) via Agent Injector.
# See charts/dataplatform-cost-dashboard/vault.example.yaml.

DATABASE_URL=postgresql+psycopg2://cost:cost@localhost:5432/cost_dashboard
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=
SNOWFLAKE_CREDIT_USD=3.0
KUBECOST_BASE_URL=http://kubecost-cost-analyzer.kubecost:9090
KUBECOST_SERVICES=airflow,rudderstack,redash
AWS_REGION=ap-south-1
ATHENA_DATABASE=athenacurcfn_prod_platform_kubecost
ATHENA_TABLE=prod_platform_kubecost
ATHENA_OUTPUT=s3://prod-platform-kubecost/athena-results/
RUDDERSTACK_S3_BUCKETS=
AIRFLOW_API_URL=
AIRFLOW_API_USER=
AIRFLOW_API_PASSWORD=
PIPELINE_DAGS=[{"dag_id":"rudderstack_s3_snowflake","destination":"snowflake"},{"dag_id":"clevertap_set_user_properties","destination":"clevertap"}]
REDASH_DATABASE_URL=
TABLEAU_SERVER_URL=
TABLEAU_SITE=
TABLEAU_PAT_NAME=
TABLEAU_PAT_SECRET=